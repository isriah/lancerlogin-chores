{
  "name": "lancerlogin-module-chores",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chores for LancerLogin Modular: rotating shop chores, recorded in Notion and announced in Discord.",
  "license": "Apache-2.0",
  "scripts": {
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"tests/*.test.ts\"",
    "verify:core": "node scripts/verify-with-core.mjs --core"
  },
  "lancerlogin": {
    "moduleId": "chores",
    "contract": 1,
    "core": ">=2.1.0-beta.13 <3.0.0",
    "tablePrefix": "chores_",
    "entries": {
      "manifest": "./src/manifest.ts",
      "api": "./src/api.ts",
      "dashboard": "./src/dashboard.tsx"
    },
    "migrations": "./migrations",
    "adoptedCoreMigrations": []
  },
  "peerDependencies": {
    "@lancerlogin/module-sdk": "^1.10.0",
    "react": "^19.1.1"
  },
  "engines": {
    "node": ">=24.10"
  }
}
